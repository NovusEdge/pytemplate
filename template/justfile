default: check

sync:
    uv sync

fmt:
    uv run ruff format .
    uv run ruff check --fix .

lint:
    uv run ruff check .
    uv run mypy src

test *ARGS:
    uv run pytest {{ARGS}}

check: lint test

clean:
    rm -rf .pytest_cache .mypy_cache .ruff_cache dist
    find . -name __pycache__ -type d -prune -exec rm -rf {} +
