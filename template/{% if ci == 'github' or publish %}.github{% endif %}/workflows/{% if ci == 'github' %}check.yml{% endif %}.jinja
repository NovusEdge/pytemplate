name: check

on:
  push:
  pull_request:

concurrency:
  group: check-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
        with:
          python-version: "{{ python }}"
          enable-cache: true
      - uses: extractions/setup-just@v2
      - run: just check
